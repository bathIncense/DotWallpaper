{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DotWallpaper",
  "version": "0.1.2",
  "identifier": "com.dot.wallpaper",
  "build": {
    "beforeDevCommand": "cd ui && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cd ui && npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "壁纸切换工具",
        "width": 1020,
        "height": 640,
        "minWidth": 800,
        "minHeight": 480,
        "center": true,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$RESOURCE/**",
          "$APPCACHE/thumbnails/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "exceptionDomain": "localhost"
    }
  },
  "plugins": {}
}
